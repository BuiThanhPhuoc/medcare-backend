# VNPay Configuration
# Hãy thay thế các giá trị bên dưới bằng thông tin thật từ VNPay

# URL VNPay (Sandbox hoặc Production)
VNPAY_URL=https://sandbox.vnpayment.vn/paygate
# VNPAY_URL=https://api.vnpayment.vn/gateway

# VNPay Terminal Code (mã đơn vị)
VNPAY_TMN_CODE=MNLMURG6

# VNPay Secret Key (khóa bí mật)
VNPAY_SECRET_KEY=GVZ45FSORQOBKHVCO5L8ZPOTRC8HMKEQ

# Return URL sau khi thanh toán (điều hướng về frontend)
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# IPN URL (callback từ VNPay, cần public domain nếu là production)
VNPAY_IPN_URL=http://your-domain.com/api/payments/vnpay/ipn

# ============================================
# Hướng dẫn lấy thông tin VNPay
# ============================================
# 1. Đăng ký tài khoản tại https://sandbox.vnpayment.vn (sandbox)
#    hoặc https://merchant.vnpayment.vn (production)
#
# 2. Sau khi đăng ký, bạn sẽ nhận được:
#    - TMN Code (Mã đơn vị)
#    - Secret Key (Khóa bí mật)
#
# 3. Cấu hình IPN URL trong admin portal VNPay:
#    - Truy cập Portal VNPay
#    - Vào Settings > IPN URL
#    - Nhập URL: http://your-domain.com/api/payments/vnpay/ipn
#
# 4. Test thanh toán:
#    - Dùng card test hoặc OTP test từ VNPay
#    - Xem tài liệu test card tại VNPay documentation
